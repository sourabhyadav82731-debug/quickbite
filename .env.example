# --- apps/api ---
PORT=3000
NODE_ENV=development

# "sqlite" for local dev (auto-seeded), "postgres" for production
DB_TYPE=sqlite
DB_SQLITE_PATH=./quickbite.sqlite

# Only used when DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=quickbite
DB_PASSWORD=quickbite
DB_DATABASE=quickbite

# Set DB_SSL=true for any managed Postgres provider that requires TLS (e.g.
# Supabase). Certificate verification stays ON by default (secure) — only set
# DB_SSL_REJECT_UNAUTHORIZED=false if your provider's own docs explicitly call
# for disabling it (rare). DB_SSL_CA is optional: paste a provider's root CA PEM
# here if its certificate isn't already covered by Node's built-in trust store.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

CORS_ORIGIN=http://localhost:3001

# Razorpay — leave blank to keep online payments disabled (COD still works).
# Never commit real values here; this file is the template only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reverse geocoding for "Use Current Location" (customer address, restaurant
# profile). "nominatim" (default) needs no key. Set to "opencage" + an API key
# for a production-grade provider.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# QuickBite Help Assistant (Groq). Leave GROQ_API_KEY blank to use the
# built-in FAQ/help system (works out of the box, no external calls). Setting
# it calls Groq's OpenAI-compatible Chat Completions API as a first attempt,
# still falling back to the FAQ system on any failure (timeout, network error,
# bad key). Backend-only — never expose this as NEXT_PUBLIC_GROQ_API_KEY or in
# any frontend code/bundle.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000
# Publishable key only — never the secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
