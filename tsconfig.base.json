{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@quickbite/types": ["packages/types/src/index.ts"],
      "@quickbite/config": ["packages/config/src/index.ts"],
      "@quickbite/validation": ["packages/validation/src/index.ts"],
      "@quickbite/api-client": ["packages/api-client/src/index.ts"]
    }
  }
}
